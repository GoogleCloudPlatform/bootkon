#
# Per-terminal init, SOURCED by the guarded ~/.bashrc block bk installs --
# it runs in every new terminal. It lives in the repo (not in ~/.bashrc) so
# a `git pull` updates terminal behavior everywhere without rewriting the
# block; the block itself is a stable two-line hook that only sets BK_DIR
# and sources this file.
#
# Rules for this file: it runs in the participant's interactive shell, so
# never `set -e`/`exit`, keep it silent on the happy path, and guard every
# expansion -- a broken line here breaks every new terminal.

case ":$PATH:" in
    *":$BK_DIR/.scripts:"*) ;;
    *) export PATH="$BK_DIR/.scripts:$PATH" ;;
esac

# vars.local.sh is hand-edited by participants; a lost quote would otherwise
# surface as a raw 'unexpected EOF' in every new terminal, with everything
# below the broken line silently unloaded. Check it and name the problem.
if [ -f "$BK_DIR/vars.local.sh" ]; then
    if bash -n "$BK_DIR/vars.local.sh" 2>/dev/null; then
        source "$BK_DIR/vars.local.sh"
    else
        echo "bootkon: vars.local.sh has a syntax error (usually a missing quote) --" >&2
        echo "bootkon: open it in the editor, fix the marked line, then run: . bk" >&2
    fi
fi

# gcloud takes the project from this env var with priority over its config --
# Cloud Shell ties the config to the project picker and may blank it, so pin
# every terminal to the persisted project instead.
if [ -n "${PROJECT_ID:-}" ]; then
    export CLOUDSDK_CORE_PROJECT="$PROJECT_ID"
fi
