# Organizer-side account AND project prep for the AGENTICDATA stream -- a
# fork of bk-bootstrap-accounts with the same CSV contract (username in the
# first column; project = PREFIX + numeric suffix of the username).
#
# For every CSV row it runs content/agenticdata/bk-prep-project (the single
# per-project entry point, Terraform-backed with per-project state), IN
# PARALLEL: the first project runs alone to warm the Terraform plugin cache,
# then BK_PREP_PARALLEL workers (default 8) fan out over the rest. Per-
# project output goes to a log directory; the console shows one line per
# project plus a red/green summary. Run it DAYS before the event and no
# IAM/API propagation race can ever reach a participant.
#
# Rerun-safe: re-running preps only what is missing (idempotent applies).

# --cloud-build: instead of running the preps locally (xargs), submit ONE
# Cloud Build per participant project (cloudbuild.yaml wraps the very same
# bk-prep-project) and watch them. The laptop only submits; the builds run
# inside the projects as their bootkon-provisioner service account.
MODE=local
if [ "${1:-}" = "--cloud-build" ]; then
    MODE=cloudbuild
    shift
fi

LOCAL_CSV_FILE="$1"
PROJECT_ID_PREFIX="$2"

RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

if [[ -z "$LOCAL_CSV_FILE" || -z "$PROJECT_ID_PREFIX" ]]; then
    echo "Error: Missing required arguments."
    echo "Usage: $(basename $0) [--cloud-build] <CSV_FILE|USERNAME> <PROJECT_ID_PREFIX>"
    echo "Examples:"
    echo "  $(basename $0) \"Bootkon Test Accounts - Sheet1.csv\" \"bootkon-dt25test-\""
    echo "  $(basename $0) --cloud-build devstar1234@gcplab.me \"bootkon-dt25test-\"   # single account"
    echo ""
    echo "The CSV file needs to have the username in the first column; passing a"
    echo "single username instead runs the identical pipeline for just that account."
    echo "Local mode parallelism: BK_PREP_PARALLEL=<n> (default 8)."
    echo "--cloud-build submits one build per project instead (fully parallel)."
    exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PREP="$SCRIPT_DIR/bk-prep-project"
if [ ! -x "$PREP" ]; then
    echo "Error: $PREP not found or not executable." >&2
    exit 1
fi

PARALLEL="${BK_PREP_PARALLEL:-8}"
LOG_DIR="$(mktemp -d "${TMPDIR:-/tmp}/bk-prep-logs.XXXXXX")"

# Collect "username project" pairs first. A username instead of a CSV file
# runs the identical pipeline for that single account (handy for testing).
# The `|| [ ... ]` keeps the final row alive when the file lacks a trailing
# newline; the \r strip guards against CRLF endings from spreadsheet exports.
ROWS=()
if [ ! -f "$LOCAL_CSV_FILE" ] && [[ "$LOCAL_CSV_FILE" == *@* ]]; then
    USERNAME="$LOCAL_CSV_FILE"
    NUMERIC_SUFFIX=$(echo "$USERNAME" | grep -o '[0-9]\+')
    ROWS+=("$USERNAME ${PROJECT_ID_PREFIX}${NUMERIC_SUFFIX}")
elif [ ! -f "$LOCAL_CSV_FILE" ]; then
    echo "Error: $LOCAL_CSV_FILE is neither a file nor a username (user@domain)." >&2
    exit 1
else
    while IFS=, read -r -a fields || [ ${#fields[@]} -gt 0 ]; do
        USERNAME=${fields[0]%$'\r'}
        [ -z "$USERNAME" ] && continue
        NUMERIC_SUFFIX=$(echo "$USERNAME" | grep -o '[0-9]\+')
        ROWS+=("$USERNAME ${PROJECT_ID_PREFIX}${NUMERIC_SUFFIX}")
    done < <(tail -n +2 "$LOCAL_CSV_FILE")
fi

if [ ${#ROWS[@]} -eq 0 ]; then
    echo "No usernames found in $LOCAL_CSV_FILE."
    exit 1
fi

if [ "$MODE" = "cloudbuild" ]; then
    REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
    echo "Preparing ${#ROWS[@]} agenticdata project(s) via Cloud Build (one build each)."
    echo ""

    # Pass 1: enable Cloud Build and create the owner service account the
    # build runs as. Deliberately a SEPARATE pass over all rows: by the time
    # pass 2 submits the builds, the owner grants have had the whole loop to
    # propagate.
    SKIP=()
    for row in "${ROWS[@]}"; do
        set -- $row; USERNAME=$1; P=$2
        echo "=== pass 1: $P (Cloud Build API + provisioner SA)"
        SA="bootkon-provisioner@${P}.iam.gserviceaccount.com"
        if ! gcloud services enable cloudbuild.googleapis.com --project="$P"; then
            echo -e "${RED}$P: enabling Cloud Build failed -- skipping this project.${NC}" >&2
            SKIP+=("$P"); continue
        fi
        if ! gcloud iam service-accounts describe "$SA" --project="$P" >/dev/null 2>&1; then
            gcloud iam service-accounts create bootkon-provisioner --project="$P" \
                --display-name="Bootkon prep (runs the Cloud Build prep)" \
                || { echo -e "${RED}$P: creating the provisioner SA failed -- skipping.${NC}" >&2; SKIP+=("$P"); continue; }
        fi
        gcloud projects add-iam-policy-binding "$P" \
            --member="serviceAccount:$SA" --role="roles/owner" --condition=None >/dev/null \
            || { echo -e "${RED}$P: granting owner to the provisioner SA failed -- skipping.${NC}" >&2; SKIP+=("$P"); }
    done
    echo ""

    # Pass 2: one async build per project; the submit uploads the checkout as
    # source (respecting .gitignore) and returns immediately.
    BUILDS=()
    for row in "${ROWS[@]}"; do
        set -- $row; USERNAME=$1; P=$2
        case " ${SKIP[*]-} " in *" $P "*) continue ;; esac
        echo "=== pass 2: $P (submitting the build)"
        id=$(gcloud builds submit --project="$P" --async --quiet \
            --config="$REPO_ROOT/content/agenticdata/cloudbuild.yaml" \
            --substitutions=_USERNAME="$USERNAME" \
            --format='value(id)' "$REPO_ROOT") \
            && BUILDS+=("$P:$id") \
            || echo -e "${RED}$P: build submit failed.${NC}" >&2
    done
    echo ""

    if [ ${#BUILDS[@]} -eq 0 ]; then
        echo -e "${RED}No builds submitted.${NC}" >&2
        exit 1
    fi
    echo "${#BUILDS[@]} build(s) running. Watching every 30s (Ctrl-C is safe -- the"
    echo "builds keep running; check later with: gcloud builds list --project=<p>)."
    PENDING=("${BUILDS[@]}")
    FAILED=()
    while [ ${#PENDING[@]} -gt 0 ]; do
        sleep 30
        NEXT=()
        for e in "${PENDING[@]}"; do
            P=${e%%:*}; id=${e#*:}
            st=$(gcloud builds describe "$id" --project="$P" --format='value(status)' 2>/dev/null)
            case "$st" in
                SUCCESS)
                    echo -e "${GREEN}$P prepared.${NC}" ;;
                FAILURE|INTERNAL_ERROR|TIMEOUT|CANCELLED|EXPIRED)
                    echo -e "${RED}$P FAILED ($st) -- log: gcloud builds log $id --project=$P${NC}"
                    FAILED+=("$P") ;;
                *)
                    NEXT+=("$e") ;;
            esac
        done
        PENDING=()
        [ ${#NEXT[@]} -gt 0 ] && PENDING=("${NEXT[@]}")
    done
    echo ""
    if [ ${#FAILED[@]} -eq 0 ] && [ ${#SKIP[@]} -eq 0 ]; then
        echo "All projects prepared."
    else
        [ ${#SKIP[@]} -gt 0 ] && echo -e "${RED}Skipped in pass 1: ${SKIP[*]}${NC}" >&2
        [ ${#FAILED[@]} -gt 0 ] && echo -e "${RED}Failed builds: ${FAILED[*]}${NC}" >&2
        echo -e "${RED}Fix the causes and rerun with --cloud-build (safe to repeat).${NC}" >&2
        exit 1
    fi
    exit 0
fi

echo "Preparing ${#ROWS[@]} agenticdata project(s), up to $PARALLEL in parallel."
echo "Per-project logs: $LOG_DIR"
echo ""

run_one() {
    local username="$1" project="$2"
    if "$PREP" "$project" "$username" >"$LOG_DIR/$project.log" 2>&1; then
        echo -e "${GREEN}$project prepared${NC} ($username)"
    else
        touch "$LOG_DIR/$project.failed"
        echo -e "${RED}$project FAILED${NC} ($username) -- log: $LOG_DIR/$project.log"
        return 1
    fi
}
export -f run_one
export PREP LOG_DIR RED GREEN NC

# First project alone: warms the shared Terraform plugin cache, so the
# parallel wave below does not race the provider download.
set -- ${ROWS[0]}
run_one "$1" "$2"
if [ ${#ROWS[@]} -gt 1 ]; then
    printf '%s\n' "${ROWS[@]:1}" | xargs -P "$PARALLEL" -L1 bash -c 'run_one "$@"' _
fi

echo ""
FAILED=("$LOG_DIR"/*.failed)
if [ ! -e "${FAILED[0]}" ]; then
    echo "All projects prepared."
else
    names=()
    for f in "${FAILED[@]}"; do
        f="$(basename "$f")"
        names+=("${f%.failed}")
    done
    echo -e "${RED}${#names[@]} project(s) had errors: ${names[*]}${NC}" >&2
    echo -e "${RED}Check the logs in $LOG_DIR, fix the causes, and rerun this script (safe to repeat).${NC}" >&2
    exit 1
fi
