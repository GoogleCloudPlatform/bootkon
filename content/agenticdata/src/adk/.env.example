# Copy to .env in this directory and fill in (Lab 6 does this with sed).
# .env is gitignored -- it will contain the database password.
# Dependencies come from content/agenticdata/requirements.txt, installed
# system-wide by bk-bootstrap in Lab 1 (no virtualenv).
# ADK 2.x docs are renaming GOOGLE_GENAI_USE_VERTEXAI to
# GOOGLE_GENAI_USE_ENTERPRISE; the old name is backward-compatible with the
# pinned version -- re-check at the smoke test.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=PROJECT_ID_PLACEHOLDER
GOOGLE_CLOUD_LOCATION=global

# Pin a concrete model version; "-latest" aliases can fail on regional endpoints.
CYMBAL_MODEL=gemini-2.5-flash

# The BigQuery data agent created in Lab 5.
DATA_AGENT_ID=cymbal-data-agent

# Live operational database, reached through the IAP tunnel (Lab 2).
CYMBAL_DB_HOST=localhost
CYMBAL_DB_PORT=5432
# DB_PASSWORD is appended from ~/.agenticdata.env in the lab.
