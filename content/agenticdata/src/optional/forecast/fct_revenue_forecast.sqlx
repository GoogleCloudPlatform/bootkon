config {
  type: "table",
  schema: "cymbal_gold",
  tags: ["forecast"],
  description: "14-day daily gross revenue forecast per currency, generated by BigQuery ML's built-in TimesFM model via AI.FORECAST. Carries only the 'forecast' tag so the Lab 3 silver/gold runs stay untouched; rebuild with `dataform run --tags forecast`.",
  columns: {
    currency: "ISO 4217 currency code — each currency is forecast as its own independent series",
    forecast_date: "Forecasted calendar date (UTC), starting the day after the last complete day of history",
    forecast_revenue: "Median (50% quantile) forecasted gross revenue in the row's currency",
    lower_bound: "Lower bound of the 95% prediction interval",
    upper_bound: "Upper bound of the 95% prediction interval"
  }
}

SELECT
  currency,
  DATE(forecast_timestamp) AS forecast_date,
  ROUND(forecast_value, 2) AS forecast_revenue,
  ROUND(prediction_interval_lower_bound, 2) AS lower_bound,
  ROUND(prediction_interval_upper_bound, 2) AS upper_bound
FROM
  AI.FORECAST(
    (
      SELECT order_date, currency, gross_revenue
      FROM ${ref("fct_daily_revenue")}
      -- Exclude the current, incomplete day: the simulator is still writing it,
      -- and a partial day would drag the first forecast points down.
      WHERE order_date < CURRENT_DATE()
    ),
    data_col => 'gross_revenue',
    timestamp_col => 'order_date',
    id_cols => ['currency'],
    horizon => 14,
    confidence_level => 0.95
  )
