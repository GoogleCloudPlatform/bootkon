# One-time, per-project prep for the agenticdata stream: everything
# project-bound that participants must not spend event time (or IAM/API
# propagation waits) on -- APIs, the Datastream service agent, the
# participant's roles, the Lab 4 data-quality service account, and the
# network path. The desired state is Terraform (see terraform/), applied
# with a per-project GCS backend: gs://<project>-tfstate, living in the
# participant project itself and created here on first run. There is
# deliberately NO central state anywhere.
#
# Callers, all through this one interface:
#   * single project:  bk-prep-project PROJECT_ID USERNAME
#   * organizers:      .scripts/bk-bootstrap-accounts-agenticdata runs it for
#                      every CSV row (in parallel), days before the event
#   * Argolis/self-run: Lab 1 has the participant run it without arguments --
#                      PROJECT_ID/GCP_USERNAME come from the bootkon
#                      environment (terraform is preinstalled in Cloud Shell)
#
# Safe to re-run any time (idempotent apply). Parallel runs for DIFFERENT
# projects are safe: each gets its own TF_DATA_DIR and its own state bucket.

set -u

PROJECT="${1:-${PROJECT_ID:-}}"
ACCOUNT="${2:-${GCP_USERNAME:-}}"
if [ -z "$PROJECT" ] || [ -z "$ACCOUNT" ]; then
    echo "Usage: $(basename "$0") [PROJECT_ID [USERNAME]]" >&2
    echo "(without arguments both come from the bootkon environment:" >&2
    echo " PROJECT_ID/GCP_USERNAME -- run '. bk' first)" >&2
    exit 1
fi
REGION="${REGION:-us-central1}"

TF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/terraform"
if ! command -v terraform >/dev/null 2>&1; then
    echo "ERROR: terraform is not installed (it is preinstalled in Cloud Shell)." >&2
    exit 1
fi

echo "Preparing project $PROJECT for $ACCOUNT ..."

# Per-project state bucket, inside the project it describes -- the state
# dies with the sandbox, and no cross-project access is ever needed.
BUCKET="${PROJECT}-tfstate"
if ! gcloud storage buckets describe "gs://$BUCKET" --project="$PROJECT" >/dev/null 2>&1; then
    echo "Creating the state bucket gs://$BUCKET ..."
    gcloud storage buckets create "gs://$BUCKET" --project="$PROJECT" \
        --location="$REGION" --uniform-bucket-level-access \
        || { echo "ERROR: creating the state bucket failed." >&2; exit 1; }
fi

# Isolate parallel runs: each project gets its own working dir; the provider
# plugin cache is shared (the organizer loop warms it with a serial first
# run before fanning out).
export TF_IN_AUTOMATION=1
export TF_DATA_DIR="${TMPDIR:-/tmp}/bootkon-tf/${PROJECT}"
export TF_PLUGIN_CACHE_DIR="${TMPDIR:-/tmp}/bootkon-tf/plugin-cache"
mkdir -p "$TF_DATA_DIR" "$TF_PLUGIN_CACHE_DIR"

terraform -chdir="$TF_DIR" init -input=false -reconfigure \
    -backend-config="bucket=$BUCKET" -backend-config="prefix=bootkon-prep" >/dev/null \
    || { echo "ERROR: terraform init for $PROJECT failed." >&2; exit 1; }

tf_apply() {
    terraform -chdir="$TF_DIR" apply -input=false -auto-approve \
        -var "project_id=$PROJECT" -var "username=$ACCOUNT" -var "region=$REGION"
}

if ! tf_apply; then
    # The one known flaky failure: the Datastream private connection loses
    # the IAM propagation race despite the time_sleep buffer and ends up
    # FAILED ("Failed to create PrivateConnection. An unknown error
    # occurred"). The proven remedy is delete + retry: by now the role has
    # long propagated, and the retry reliably succeeds (the time_sleep is
    # already in the state, so the second apply goes straight to the
    # create). Anything else stays a hard error.
    psc_state="$(gcloud datastream private-connections describe cymbal-psc \
        --location="$REGION" --project="$PROJECT" --format='value(state)' 2>/dev/null || true)"
    if [ "$psc_state" = "FAILED" ] || [ "$psc_state" = "FAILED_TO_DELETE" ]; then
        echo "Private connection ended $psc_state (IAM propagation race) -- deleting it and retrying once ..."
        gcloud datastream private-connections delete cymbal-psc \
            --location="$REGION" --project="$PROJECT" --quiet || true
        # Deletion is asynchronous; wait until it is really gone, otherwise
        # the re-create collides with the name.
        while gcloud datastream private-connections describe cymbal-psc \
            --location="$REGION" --project="$PROJECT" >/dev/null 2>&1; do
            sleep 10
        done
        tf_apply || { echo "ERROR: retry apply for $PROJECT failed -- see above." >&2; exit 1; }
    else
        echo "ERROR: terraform apply for $PROJECT failed -- see above. Re-running is" >&2
        echo "safe. A 409/alreadyExists usually means the project was prepped by the" >&2
        echo "old gcloud-based flow: use a fresh project, or import the existing" >&2
        echo "resources into the state." >&2
        exit 1
    fi
fi
echo "Project $PROJECT prepared."
