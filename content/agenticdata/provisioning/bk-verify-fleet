# READ-ONLY readiness check for prepped agenticdata projects -- the
# counterpart to bk-prep-fleet: same CSV contract (username in the first
# column; project = PREFIX + numeric suffix), or a single username instead
# of a CSV. For every project it verifies what bk-prep-project should have
# left behind: the load-bearing APIs, the participant's roles, the
# Datastream service agent, the data-quality service account, the network
# path, the private connection (CREATED), the jump VM, the PSC endpoint and
# the Cloud SQL instance (parked or woken both count as ready). One green
# line per healthy project; failing checks list red, and the exit code says
# whether the fleet is event-ready. Changes nothing, safe to run any time.
#
# Usage: bk-verify-fleet <CSV_FILE|USERNAME> [PROJECT_ID_PREFIX]
# The prefix is optional here: without it the projects are looked up by the
# username's number (one `gcloud projects list`, matched locally), so a
# readiness check needs nothing but the account list.
# Parallelism: BK_PREP_PARALLEL=<n> (default 8).

LOCAL_CSV_FILE="$1"
PROJECT_ID_PREFIX="$2"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

if [[ -z "$LOCAL_CSV_FILE" ]]; then
    echo "Usage: $(basename $0) <CSV_FILE|USERNAME> [PROJECT_ID_PREFIX]"
    echo "Examples:"
    echo "  $(basename $0) \"Bootkon Test Accounts - Sheet1.csv\""
    echo "  $(basename $0) devstar1234@gcplab.me                     # single account"
    echo "  $(basename $0) devstar1234@gcplab.me \"bootkon-dt25test-\"   # pin the prefix"
    echo ""
    echo "Without a prefix the projects are looked up by the username's number."
    exit 1
fi

CALLER="$(gcloud config get-value account 2>/dev/null)"
if [ -z "$CALLER" ] || [ "$CALLER" = "(unset)" ]; then
    echo -e "${RED}Error: No active gcloud account set on this machine. Run 'gcloud auth login' first.${NC}" >&2
    exit 1
fi

REGION="${REGION:-us-central1}"
PARALLEL="${BK_PREP_PARALLEL:-8}"
STATUS_DIR="$(mktemp -d "${TMPDIR:-/tmp}/bk-verify.XXXXXX")"

# Usernames first (single username or CSV; final-row and CRLF guards
# included, same contract as bk-prep-fleet).
USERS=()
if [ ! -f "$LOCAL_CSV_FILE" ] && [[ "$LOCAL_CSV_FILE" == *@* ]]; then
    USERS+=("$LOCAL_CSV_FILE")
elif [ ! -f "$LOCAL_CSV_FILE" ]; then
    echo "Error: $LOCAL_CSV_FILE is neither a file nor a username (user@domain)." >&2
    exit 1
else
    while IFS=, read -r -a fields || [ ${#fields[@]} -gt 0 ]; do
        USERNAME=${fields[0]%$'\r'}
        [ -z "$USERNAME" ] && continue
        USERS+=("$USERNAME")
    done < <(tail -n +2 "$LOCAL_CSV_FILE")
fi
if [ ${#USERS[@]} -eq 0 ]; then
    echo "No usernames found in $LOCAL_CSV_FILE."
    exit 1
fi

# Project ids are PREFIX + the username's number. Without a prefix, derive
# it once from the first matching user in the CSV -- all projects in a fleet
# share the same prefix.
if [ -z "$PROJECT_ID_PREFIX" ]; then
    echo "No project prefix given -- deriving it from the projects you can see ..."
    ALL_PROJECTS="$(gcloud projects list --format='value(projectId)' 2>/dev/null)"
    if [ -z "$ALL_PROJECTS" ]; then
        echo "Error: could not list any projects -- pass the prefix explicitly." >&2
        exit 1
    fi
    for USERNAME in "${USERS[@]}"; do
        SUFFIX="$(printf '%s' "${USERNAME%%@*}" | grep -o '[0-9]\+' | tail -1)"
        [ -z "$SUFFIX" ] && continue
        MATCHES="$(printf '%s\n' "$ALL_PROJECTS" | grep -E -- "([^0-9]|^)${SUFFIX}$" || true)"
        COUNT="$(printf '%s' "$MATCHES" | grep -c . || true)"
        if [ "$COUNT" = "1" ]; then
            PROJECT_ID_PREFIX="${MATCHES%"${SUFFIX}"}"
            echo "Derived project prefix '$PROJECT_ID_PREFIX' (from $MATCHES for $USERNAME)."
            break
        fi
    done
    if [ -z "$PROJECT_ID_PREFIX" ]; then
        echo "Error: could not derive project prefix from any user in $LOCAL_CSV_FILE -- pass the prefix explicitly." >&2
        exit 1
    fi
fi

ROWS=()
RESOLVE_FAILED=0
for USERNAME in "${USERS[@]}"; do
    # Digits from the local part only, last group -- a domain like
    # gcp2lab.me must not end up in the project id.
    SUFFIX="$(printf '%s' "${USERNAME%%@*}" | grep -o '[0-9]\+' | tail -1)"
    if [ -z "$SUFFIX" ]; then
        echo -e "${RED}$USERNAME: no number in the username to build a project id from.${NC}" >&2
        RESOLVE_FAILED=1
        continue
    fi
    ROWS+=("$USERNAME ${PROJECT_ID_PREFIX}${SUFFIX}")
done
if [ "$RESOLVE_FAILED" = "1" ] || [ ${#ROWS[@]} -eq 0 ]; then
    echo "Aborting due to project resolution errors." >&2
    exit 1
fi
echo "Verifying ${#ROWS[@]} agenticdata project(s), up to $PARALLEL in parallel ..."
echo ""

verify_one() {
    local username="$1" project="$2"
    local fails=() passes=()

    exists() {  # LABEL cmd... -- resource must describe cleanly
        local label="$1"; shift
        if "$@" >/dev/null 2>&1; then passes+=("$label"); else fails+=("$label"); fi
    }

    # Is a prep currently running against this project? Two signals: an
    # active Cloud Build (the fleet's cloud-build mode) or a held terraform
    # state lock in the project's state bucket (any runner).
    local running=""
    local build_id
    build_id="$(gcloud builds list --project="$project" \
        --filter='status=WORKING OR status=QUEUED' --format='value(id)' --limit=1 2>/dev/null)"
    [ -n "$build_id" ] && running="cloud build $build_id"
    if [ -z "$running" ] && gcloud storage ls "gs://${project}-tfstate/bootkon-prep/default.tflock" >/dev/null 2>&1; then
        running="terraform holds the state lock"
    fi

    exists "VPC cymbal-vpc" \
        gcloud compute networks describe cymbal-vpc --project="$project"
    exists "subnet cymbal-subnet" \
        gcloud compute networks subnets describe cymbal-subnet --region="$REGION" --project="$project"
    exists "reserved endpoint IP (cymbal-endpoint-ip)" \
        gcloud compute addresses describe cymbal-endpoint-ip --region="$REGION" --project="$project"
    exists "network attachment cymbal-attachment" \
        gcloud compute network-attachments describe cymbal-attachment --region="$REGION" --project="$project"
    exists "firewall allow-iap-ingress" \
        gcloud compute firewall-rules describe allow-iap-ingress --project="$project"
    exists "jump VM cymbal-jump" \
        gcloud compute instances describe cymbal-jump --zone="${REGION}-a" --project="$project"
    exists "PSC endpoint cymbal-endpoint" \
        gcloud compute forwarding-rules describe cymbal-endpoint --region="$REGION" --project="$project"
    exists "data-quality service account" \
        gcloud iam service-accounts describe "dataquality-service-account@${project}.iam.gserviceaccount.com" --project="$project"
    exists "seed bucket gs://${project}-bucket" \
        gcloud storage buckets describe "gs://${project}-bucket" --project="$project"
    exists "BigQuery connection profile cymbal-bq-profile" \
        gcloud datastream connection-profiles describe cymbal-bq-profile --location="$REGION" --project="$project"
    exists "seed data imported into Cloud SQL" \
        gcloud storage ls "gs://${project}-bucket/seed/.imported-reviews"
    exists "bronze dataset cymbal_bronze" \
        bq --project_id="$project" --format=none show --dataset "${project}:cymbal_bronze"

    local psc_state
    psc_state="$(gcloud datastream private-connections describe cymbal-psc \
        --location="$REGION" --project="$project" --format='value(state)' 2>/dev/null)"
    if [ "$psc_state" = "CREATED" ]; then
        passes+=("private connection cymbal-psc")
    else
        fails+=("private connection cymbal-psc (state: ${psc_state:-missing})")
    fi

    local sql_state sql_policy
    sql_state="$(gcloud sql instances describe cymbal-oltp --project="$project" \
        --format='value(state)' 2>/dev/null)"
    sql_policy="$(gcloud sql instances describe cymbal-oltp --project="$project" \
        --format='value(settings.activationPolicy)' 2>/dev/null)"
    # Parked (STOPPED / activation policy NEVER) is the DESIRED pre-event
    # state -- the participant's `. bk` wakes the instance. Both parked and
    # running count as ready; the state/policy is shown for orientation.
    case "$sql_state" in
        RUNNABLE|STOPPED)
            passes+=("Cloud SQL cymbal-oltp ($sql_state, ${sql_policy:-?})") ;;
        *)
            fails+=("Cloud SQL cymbal-oltp (state: ${sql_state:-missing})") ;;
    esac

    # The labs' gateway APIs -- one enabled-services call, spot-checked.
    local enabled api
    enabled="$(gcloud services list --enabled --project="$project" --format='value(config.name)' 2>/dev/null)"
    for api in datastream.googleapis.com sqladmin.googleapis.com compute.googleapis.com \
        bigquery.googleapis.com dataplex.googleapis.com aiplatform.googleapis.com \
        geminidataanalytics.googleapis.com; do
        if grep -qxF "$api" <<< "$enabled"; then passes+=("API $api"); else fails+=("API $api"); fi
    done

    # The participant's roles and the Datastream service agent, from one
    # policy read.
    local policy pn
    policy="$(gcloud projects get-iam-policy "$project" \
        --flatten="bindings[].members" --format='value(bindings.role,bindings.members)' 2>/dev/null)"
    local role
    for role in roles/editor roles/resourcemanager.projectIamAdmin roles/datastream.admin \
        roles/bigquery.admin roles/dataplex.admin; do
        if grep -qE "^${role}[[:space:]]+user:${username}$" <<< "$policy"; then
            passes+=("role $role")
        else
            fails+=("role $role for $username")
        fi
    done
    pn="$(gcloud projects describe "$project" --format='value(projectNumber)' 2>/dev/null)"
    if grep -qE "^roles/datastream.serviceAgent[[:space:]]+serviceAccount:service-${pn}@gcp-sa-datastream" <<< "$policy"; then
        passes+=("Datastream service agent role")
    else
        fails+=("Datastream service agent role")
    fi

    # Ready: one green line. Prep still running: yellow, with the component
    # split so you can watch it fill up. Failed and idle: red with both
    # lists -- what is there, what is missing.
    local f
    if [ ${#fails[@]} -eq 0 ]; then
        echo -e "${GREEN}$project ready${NC} ($username; SQL ${sql_state:-?}/${sql_policy:-?})"
    elif [ -n "$running" ]; then
        touch "$STATUS_DIR/$project.running"
        echo -e "${YELLOW}$project PREP IN PROGRESS${NC} ($running) -- ${#passes[@]} of $(( ${#passes[@]} + ${#fails[@]} )) checks green:"
        for f in "${fails[@]}"; do echo -e "${YELLOW}    pending: $f${NC}"; done
    else
        touch "$STATUS_DIR/$project.failed"
        echo -e "${RED}$project NOT ready${NC} ($username):"
        for f in "${passes[@]}"; do echo -e "${GREEN}    ok:      $f${NC}"; done
        for f in "${fails[@]}"; do echo -e "${RED}    missing: $f${NC}"; done
    fi
}
export -f verify_one
export STATUS_DIR REGION RED GREEN YELLOW NC

printf '%s\n' "${ROWS[@]}" | xargs -P "$PARALLEL" -L1 bash -c 'verify_one "$@"' _

echo ""
FAILED=("$STATUS_DIR"/*.failed)
RUNNING=("$STATUS_DIR"/*.running)
if [ ! -e "${FAILED[0]}" ] && [ ! -e "${RUNNING[0]}" ] && [ "$RESOLVE_FAILED" = 0 ]; then
    echo "All projects ready."
else
    if [ -e "${RUNNING[0]}" ]; then
        names=()
        for f in "${RUNNING[@]}"; do f="$(basename "$f")"; names+=("${f%.running}"); done
        echo -e "${YELLOW}${#names[@]} project(s) still provisioning: ${names[*]}${NC}"
        echo -e "${YELLOW}Verify again in a few minutes.${NC}"
    fi
    if [ -e "${FAILED[0]}" ]; then
        names=()
        for f in "${FAILED[@]}"; do f="$(basename "$f")"; names+=("${f%.failed}"); done
        echo -e "${RED}${#names[@]} project(s) not ready: ${names[*]}${NC}" >&2
        echo -e "${RED}Re-run bk-prep-fleet for them (safe to repeat), then verify again.${NC}" >&2
    fi
    exit 1
fi
